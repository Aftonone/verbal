# .NET build and publish outputs
[Bb]in/
[Oo]bj/
[Pp]ublish/
.vs/

# User-specific IDE files
*.user
*.suo
*.userosscache
*.sln.docstates
.idea/

# Python caches and virtual environments
__pycache__/
*.py[cod]
.venv/
venv/

# Whisper model weights (users add models to this folder)
whisper_cpp/models/*.bin

# Keep the runtime Whisper CLI, not bundled test/tools executables
whisper_cpp/*.exe
whisper_cpp/**/*.exe
!whisper_cpp/whisper-cli.exe

# Local and temporary files
*.log
*.tmp
Thumbs.db
Desktop.ini
