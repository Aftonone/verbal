<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>Verbal</AssemblyName>
    <RootNamespace>Verbal</RootNamespace>
    <AssemblyTitle>Verbal</AssemblyTitle>
    <Product>Verbal</Product>
    <Description>Local voice transcription and text input utility</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\settings.png" />
    <Content Include="Assets\app.ico"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="whisper_cpp\whisper-cli.exe;whisper_cpp\*.dll;whisper_cpp\models\README.txt"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="whisper_cpp\cuda\whisper-cli.exe"
             Condition="Exists('whisper_cpp\cuda\whisper-cli.exe')"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="whisper_cpp\cuda\*.dll"
             Condition="Exists('whisper_cpp\cuda\whisper-cli.exe')"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
