<Window x:Class="Verbal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verbal"
        Width="460"
        Height="500"
        MinWidth="380"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource Ink}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="32"
                          Height="32"
                          Margin="0,0,9,0"
                          VerticalAlignment="Center"
                          ToolTip="Microphone input level while recording">
                        <Ellipse x:Name="OuterSoundWave"
                                 Width="32"
                                 Height="32"
                                 Stroke="{DynamicResource Accent}"
                                 StrokeThickness="2"
                                 Opacity="0"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                        <Ellipse x:Name="MiddleSoundWave"
                                 Width="23"
                                 Height="23"
                                 Stroke="{DynamicResource Accent}"
                                 StrokeThickness="2"
                                 Opacity="0"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                        <Ellipse x:Name="InnerSoundWave"
                                 Width="15"
                                 Height="15"
                                 Stroke="{DynamicResource Accent}"
                                 StrokeThickness="2"
                                 Opacity="0"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                        <Ellipse x:Name="StatusDot"
                                 Width="9"
                                 Height="9"
                                 Fill="{DynamicResource StatusIdle}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="StatusText"
                               Text="Ready when you are"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock x:Name="StatusDetailText"
                           Text="Choose a destination, then speak."
                           FontSize="11"
                           Foreground="{DynamicResource MutedInk}"
                           Margin="41,4,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button x:Name="SettingsButton"
                    Grid.Column="1"
                    Padding="10,8"
                    ToolTip="Settings"
                    Click="SettingsButton_Click">
                <Border Width="18"
                        Height="18"
                        Background="{DynamicResource Ink}"
                        AutomationProperties.Name="Settings icon">
                    <Border.OpacityMask>
                        <ImageBrush ImageSource="Assets/settings.png"
                                    Stretch="Uniform" />
                    </Border.OpacityMask>
                </Border>
            </Button>
            <Popup x:Name="SettingsPopup"
                   PlacementTarget="{Binding ElementName=SettingsButton}"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   PopupAnimation="Fade">
                <Border Width="320"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,6,6,6">
                    <StackPanel>
                        <TextBlock Text="SETTINGS"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MutedInk}" />
                        <TextBlock Text="Microphone"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,12,0,5" />
                        <ComboBox x:Name="MicrophoneSelector"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="MicrophoneSelector_SelectionChanged"
                                  AutomationProperties.Name="Microphone input device" />
                        <TextBlock Text="Input level appears while recording."
                                   FontSize="10"
                                   Foreground="{DynamicResource MutedInk}"
                                   Margin="0,9,0,0" />
                        <TextBlock Text="Whisper model"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,14,0,5" />
                        <ComboBox x:Name="ModelSelector"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="ModelSelector_SelectionChanged"
                                  AutomationProperties.Name="Whisper model" />
                        <TextBlock x:Name="ModelHintText"
                                   Text="Add ggml model .bin files to whisper_cpp\models."
                                   FontSize="10"
                                   Foreground="{DynamicResource MutedInk}"
                                   Margin="0,7,0,0"
                                   TextWrapping="Wrap" />
                        <DockPanel Margin="0,14,0,0">
                            <TextBlock Text="Dark mode"
                                       FontSize="12"
                                       Foreground="{DynamicResource Ink}"
                                       VerticalAlignment="Center"
                                       DockPanel.Dock="Left" />
                            <ToggleButton x:Name="DarkModeToggle"
                                          Style="{StaticResource ThemeToggleStyle}"
                                          IsChecked="False"
                                          HorizontalAlignment="Right"
                                          Click="DarkModeToggle_Click"
                                          AutomationProperties.Name="Dark mode" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="HoldButton"
                    Grid.Column="0"
                    Height="72"
                    Background="{DynamicResource Accent}"
                    BorderThickness="0"
                    Foreground="White"
                    Padding="12"
                    PreviewMouseLeftButtonDown="HoldButton_PreviewMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="HoldButton_PreviewMouseLeftButtonUp"
                    LostMouseCapture="HoldButton_LostMouseCapture"
                    PreviewKeyDown="HoldButton_PreviewKeyDown"
                    PreviewKeyUp="HoldButton_PreviewKeyUp">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HoldBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="●  HOLD TO TALK"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="F8"
                                           FontSize="10"
                                           Opacity="0.8"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoldBorder" Property="Background" Value="{DynamicResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoldBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="HoldBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="ToggleButton"
                    Grid.Column="2"
                    Height="72"
                    Click="ToggleButton_Click"
                    Padding="12">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="ToggleLabel"
                               Text="START RECORDING"
                               FontSize="11"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="F9 · toggle"
                               FontSize="10"
                               Foreground="{DynamicResource MutedInk}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="1"
                CornerRadius="13"
                Padding="14"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="TRANSCRIPT"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource MutedInk}" />
                    <TextBlock x:Name="WordCountText"
                               Text="0 words"
                               HorizontalAlignment="Right"
                               FontSize="10"
                               Foreground="{DynamicResource MutedInk}" />
                </Grid>
                <TextBox x:Name="TranscriptBox"
                         Grid.Row="1"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource Ink}"
                         FontSize="13"
                         Padding="2,4"
                         TextChanged="TranscriptBox_TextChanged"
                         AutomationProperties.Name="Editable transcript" />
                <Grid Grid.Row="2" Margin="0,9,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="InsertButton"
                                Content="Insert"
                                Background="{DynamicResource Accent}"
                                Foreground="White"
                                BorderThickness="0"
                                Padding="13,8"
                                Click="InsertButton_Click" />
                        <Button Content="Copy"
                                Margin="7,0,0,0"
                                Padding="13,8"
                                Click="CopyButton_Click" />
                    </StackPanel>
                    <DockPanel HorizontalAlignment="Right"
                               VerticalAlignment="Center">
                        <TextBlock Text="Type automatically"
                                   FontSize="11"
                                   Foreground="{DynamicResource Ink}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ToggleButton x:Name="AutoTypeToggle"
                                      Style="{StaticResource ThemeToggleStyle}"
                                      IsChecked="True"
                                      Click="AutoTypeToggle_Click"
                                      AutomationProperties.Name="Type automatically" />
                    </DockPanel>
                </Grid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="F8  Hold to talk     ·     F9  Toggle"
                   FontSize="10"
                   Foreground="{DynamicResource MutedInk}"
                   VerticalAlignment="Center" />
    </Grid>
</Window>
